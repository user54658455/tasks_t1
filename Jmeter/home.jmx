                    <stringProp name="filename"></stringProp>
                    <stringProp name="cacheKey">true</stringProp>
                    <stringProp name="script">def newUsername = args[0];
def currentUserLogin = args[1];

//log.info(&quot;!!!!!!!!!!!!!!!! newUsername &quot; + newUsername);
//log.info(&quot;!!!!!!!!!!!!!!!! currentUserLogin  &quot; + currentUserLogin);

if(currentUserLogin == newUsername) {
     AssertionResult.setFailure(false)
} else {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;пользователь использованный для логина из users.csv не совпадает с текущим&quot;);
}</stringProp>

              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters">${random_user_login} ${current_user_login}</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">def randomUserLogin = args[0];
def currentUserLogin = args[1];

//log.info(&quot;!!!!!!!!!!!!!!!! randomUserLogin &quot; + randomUserLogin);
//log.info(&quot;!!!!!!!!!!!!!!!! currentUserLogin  &quot; + currentUserLogin);

if(currentUserLogin == randomUserLogin) {
	AssertionResult.setFailure(false)
} else {
	AssertionResult.setFailure(true)
	AssertionResult.setFailureMessage(&quot;пользователь использованный для логина из users.csv не совпадает с текущим&quot;);
	log.info(&quot;!!!!!!!!!!!!!!!! randomUserLogin &quot; + randomUserLogin);
	log.info(&quot;!!!!!!!!!!!!!!!! currentUserLogin  &quot; + currentUserLogin);
}</stringProp>

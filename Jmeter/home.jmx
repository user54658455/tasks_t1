              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
                <stringProp name="scriptLanguage">java</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import java.io.FileWriter;
import java.io.Writer;
import java.util.Arrays;
import java.util.List;
import java.io.File;

char separator = &apos;,&apos;;

//function write line in csv
public void writeLine(FileWriter writer, String[] params, charseparator) {
  boolean firstCred = true;
  StringBuilder stringBuilder = new StringBuilder();
  String cred = &quot;&quot;;
  for (int i = 0; i &lt; creds.length; i++)
  {
    //get cred
    cred = creds[i];
    //log.info(&quot;!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! cred is &quot; + cred);

    //if the first cred in the line, separator is not needed
    if (!firstCred) {
      stringBuilder.append(separator);
    }

    //Add cred to line
    stringBuilder.append(cred);
    firstCred = false;
  }

  //prepare file to next line
  stringBuilder.append(&quot;\n&quot;);

  //add to file the line
  writer.append(stringBuilder.toString());
}

//create folder &quot;../test_data&quot;
File directory = new File(&quot;../test_data&quot;);
if (!directory.exists()) {
	boolean result = directory.mkdir();
	if(result) {
		log.info(&quot;!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! directory &apos;../test_data&apos; created&quot;);
	}
}
String csvFile = &quot;../test_data/users.csv&quot;;


String[] creds = {&quot;${new_username}&quot;, &quot;${new_pass}&quot;, &quot;${new_firstname}&quot;, &quot;${new_lastname}&quot;, &quot;${new_address1}&quot;, &quot;${new_address2}&quot;};

//Here &apos;true&apos; mean append lines to file. And &apos;false&apos; mean override file.
FileWriter fileWriter = new FileWriter(csvFile, true);

writeLine(fileWriter, creds, separator);

//proper close to file
fileWriter.flush();
fileWriter.close();</stringProp>
                <stringProp name="TestPlan.comments">new users to .csv (csv file saving to &apos;test_data&apos; (creates if not exists) in jmeter directory next to &apos;bin&apos; folder)</stringProp>
              </JSR223PostProcessor>

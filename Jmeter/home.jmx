              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
                <stringProp name="scriptLanguage">java</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import org.apache.commons.io.FileUtils;
import java.util.concurrent.ThreadLocalRandom;

List lines = FileUtils.readLines(new File(&quot;../test_data/users.csv&quot;));
int maxRowNumber = lines.size();
int rowRandomNumber = ThreadLocalRandom.current().nextInt(0, maxRowNumber);
String rowRandom = lines.get(rowRandomNumber);
String[] cells = rowRandom.split(&quot;,&quot;);
String cell1 = cells[0];
String cell2 = cells[1];
//log.info(&quot;!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!               maxRowNumber is &quot; + maxRowNumber);
//log.info(&quot;!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!               rowRandomNumber is &quot; + rowRandomNumber);
//log.info(&quot;!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!               random row (starts from zero) is &quot; + rowRandom);
//log.info(&quot;!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!               cell1 value = &quot; + cell1 + &quot; and cell2 value = &quot; + cell2);
vars.put(&quot;random_user_login&quot;, cell1);
vars.put(&quot;random_user_pass&quot;, cell2);</stringProp>
              </JSR223PreProcessor>

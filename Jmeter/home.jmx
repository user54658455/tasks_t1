                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import org.apache.commons.io.FileUtils;
import java.util.concurrent.ThreadLocalRandom;

List lines = FileUtils.readLines(new File(&quot;../test_data/users.csv&quot;));

int maxRowNumber = lines.size();

String rowFirst = lines.get(0);
String[] cells = rowFirst.split(&quot;,&quot;);
String cellFirst = cells[0];
String currentUserLogin = args[0];

int i = 0;
if (cellFirst.equals(currentUserLogin)) {
	//log.info(&quot;!!!!!!!!!		!!!!!!!!!!!		!!!!!!!!!!!!		!!!!!!!!!!               FOUND HIM: &quot; + cellFirst + &quot; is our current user&quot;);
	i++;
} else {
	while (!cellFirst.equals(currentUserLogin) &amp;&amp; i &lt;= maxRowNumber) {
		String rowI = lines.get(i);
		String[] cellsI = rowI.split(&quot;,&quot;);
		cellFirst = cellsI[0];
		//log.info(&quot;!!!!!!!!!		!!!!!!!!!!!		!!!!!!!!!!!!		!!!!!!!!!!               cellIFirst: &quot; + cellFirst + &quot; is not who we are looking for, i = &quot; + i);
		i++;
	}
	//log.info(&quot;!!!!!!!!!		!!!!!!!!!!!		!!!!!!!!!!!!		!!!!!!!!!!               FOUND HIM (after a while): &quot; + cellFirst + &quot; is our current user&quot;);
}

String rowWanted = lines.get(i-1);
String[] cellsWanted = rowWanted.split(&quot;,&quot;);
vars.put(&quot;random_user_firstname&quot;, cellsWanted[2]);
vars.put(&quot;random_user_lastname&quot;, cellsWanted[3]);
vars.put(&quot;random_user_address1&quot;, cellsWanted[4]);
vars.put(&quot;random_user_address2&quot;, cellsWanted[5]);
</stringProp>
